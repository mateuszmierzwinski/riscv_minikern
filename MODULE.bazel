module(
    name = "minikern",
    version = "1.0",
)

# The cc_toolchain plumbing the kernel's own freestanding RV64GC toolchain is
# built on (toolchain/cc_toolchain_config.bzl), and shell rules for the QEMU
# tests — Bazel 9 removed the native sh_test.
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_shell", version = "0.6.1")

# The Go side: the test program that proves the goal — a stock gc binary for
# linux/riscv64, pure and static, built by the ordinary Go rules. It is
# standard library only, so there are no external modules to resolve and
# gazelle is not needed.
bazel_dep(name = "rules_go", version = "0.59.0", repo_name = "io_bazel_rules_go")

# A downloaded SDK rather than the host's, so every machine builds the same Go
# and the test does not quietly change version underneath it.
go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.25.5")

# rules_pkg (a root filesystem) comes back with the phase that needs it; see
# docs/DEVELOPMENT_PROGRESS.md. A module that declares what it does not use is a
# dependency nobody checked.
