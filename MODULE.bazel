module(
    name = "minikern",
    version = "1.0",
)

# The cc_toolchain plumbing the kernel's own freestanding RV64GC toolchain is
# built on (toolchain/cc_toolchain_config.bzl), and shell rules for the QEMU
# tests — Bazel 9 removed the native sh_test.
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_shell", version = "0.6.1")

# rules_pkg (a root filesystem) and rules_go (the userland and the netboot
# server) come back with the phases that need them; see TASKS.md. A module
# that declares what it does not use is a dependency nobody checked.
